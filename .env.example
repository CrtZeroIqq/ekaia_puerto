# EKAIA Configuration

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=ekaia
DB_PASSWORD=your_secure_password
DB_NAME=ekaia_puerto

# RTSP Cameras
RTSP_ENTRADA=rtsp://admin:password@192.168.88.107:554/cam/realmonitor?channel=1&subtype=0
RTSP_SALIDA=rtsp://admin:password@192.168.88.108:554/cam/realmonitor?channel=1&subtype=0

# YOLO Model
YOLO_MODEL_PATH=/home/seidgc/ekaia-engine/models/patentes.pt
YOLO_CONFIDENCE=0.5
YOLO_DEVICE=0

# OCR
OCR_LANG=en
OCR_GPU=True

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Cloudflare Tunnel
CF_TUNNEL_TOKEN=your_tunnel_token
